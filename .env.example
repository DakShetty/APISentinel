# API Sentinel Configuration Environment Variables

# Application
PROJECT_NAME="API Sentinel"
VERSION="1.0.0"
API_PREFIX="/api"

# Security & Tokens
SECRET_KEY="apisentinel_super_secret_jwt_key_2026_x89a!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite database. For PostgreSQL: postgresql://user:password@localhost:5432/apisentinel
DATABASE_URL="sqlite:///./apisentinel.db"

# Scanner Engine Limits & SSRF Controls
ALLOW_LOCAL_NETWORK_SCAN=True
SCAN_DEFAULT_TIMEOUT=8
MAX_CONCURRENT_SCANS=3
MAX_REQUESTS_PER_ENDPOINT=15

# Reports Directory
REPORTS_DIR="./generated_reports"

